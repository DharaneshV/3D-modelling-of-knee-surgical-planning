# Project-specific data and results
data/
# results/* (not results/) so git still descends into the dir and the
# negation below can take effect — a parent dir exclusion can't be undone.
results/*
# The accuracy report is a core spec deliverable — keep it tracked.
!results/dice_scores_summary.csv
measurement_validation.csv
node_modules/
package-lock.json
cmts.txt

# Automated pipeline outputs
meshes/
uploads/
tasks/
outputs/
*.obj
*.png
temp_*/
test_*.py
# ...but the real pytest suite must stay tracked. The unanchored rule above was
# meant for the ad-hoc test_*.py scratch scripts at repo root, and silently
# swallowed tests/ too — which is how tests/test_boolean_resolution.py drifted
# out of sync with its module without ever showing up in a diff.
!tests/test_*.py
test_ct.nii.gz
test_correlation.py

# Agent worktrees — checkouts of this same repo, never their own content
.claude/worktrees/

# Large generated experiment data/outputs (keep experiments/*/*.py source tracked)
experiments/*/data/
experiments/*/output/

# Generated outputs from pipeline runs
outputs_bilateral/
scratch/
cache/

# Profiling / ad-hoc pipeline debug output
profile_output/
profile_seg_output/
test_meshing_*/
test_verify_*/
test_filled_mask.nii.gz

# Regenerable QA run artifacts
batch_qa_mri_results.json
batch_visual_run.jsonl
